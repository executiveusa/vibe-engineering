{
  "name": "vibe-engineering",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build && npm run truth:compile",
    "preview": "vite preview",
    "truth:compile": "node scripts/truth-compile.mjs",
    "truth:source-check": "node scripts/truth-source-check.mjs",
    "truth:api": "npm run truth:compile && node scripts/truth-api.mjs",
    "truth:preview-verify": "node scripts/truth-preview-verify.mjs",
    "vibe": "node scripts/vibe.mjs",
    "mcp": "node scripts/vibe-mcp-stdio.mjs",
    "check": "npm run truth:source-check && npm run test && npm run build",
    "factory:new": "node scripts/factory-new.mjs",
    "factory:one-click": "node scripts/factory-new.mjs",
    "factory:doctor": "node scripts/factory-governor.mjs",
    "icmr:validate": "node scripts/icmr-validate.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "gsap": "3.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  },
  "devDependencies": {}
}

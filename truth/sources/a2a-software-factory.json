{
  "id": "workflow.a2a-software-factory",
  "kind": "workflow",
  "version": "1.0.0",
  "status": "approved",
  "precedence": 700,
  "title": "A2A Autonomous Software Factory",
  "sourcePath": "workflows/a2a-software-factory/WORKFLOW.md",
  "summary": "Architect, Builder, Harness, Judge, semantic gate, merge, post-merge verification, and recovery workflow.",
  "modes": ["discovery", "blueprint", "autonomous-execution", "recovery", "public-release"],
  "roles": ["architect", "builder", "judge"],
  "stages": [
    "project-discovery",
    "system-blueprint",
    "human-blueprint-approved",
    "phase-queued",
    "architect-phase-directive",
    "builder-hydrate-context",
    "baseline-captured",
    "spec-validated",
    "workspace-provisioned",
    "implementation-loop",
    "local-harness",
    "pr-created-or-updated",
    "pr-repair-loop",
    "judge-review",
    "architect-semantic-gate",
    "merge",
    "post-merge-verify",
    "phase-receipt-final"
  ],
  "limits": { "meaningfulRepairAttempts": 5 },
  "humanGates": ["blueprint-approval", "high-consequence-public-release"],
  "proof": ["baseline", "spec-validation", "local-harness", "independent-judge-verdict", "post-merge-runtime-verification"],
  "rollback": "Enter recovery mode, halt dependent phases, preserve evidence, and restore the last verified state."
}

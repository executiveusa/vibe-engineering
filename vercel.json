{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-audit --no-fund",
  "cleanUrls": true,
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 10,
      "includeFiles": "{truth/sources/**,AGENTS.md,ICMR.yaml,icm/**,src/mcp/**,src/skills/**,src/icmr/**,factory/icm/**,scripts/vibe.mjs,scripts/truth-api.mjs,api/mcp.mjs,api/v1/**,openapi/vibe-truth-api-v1.yaml,vercel.json}"
    }
  },
  "rewrites": [
    { "source": "/api/v1/skills", "destination": "/api/v1/router?route=skills" },
    { "source": "/api/v1/skills/:id", "destination": "/api/v1/router?route=skill&id=:id" },
    { "source": "/api/v1/icm/map", "destination": "/api/v1/router?route=icm-map" },
    { "source": "/api/v1/icm/walk", "destination": "/api/v1/router?route=icm-walk" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}

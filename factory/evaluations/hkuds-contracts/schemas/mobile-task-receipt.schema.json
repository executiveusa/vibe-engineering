{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"starnet://schemas/mobile-task-receipt",
  "type":"object",
  "required":["task_id","instruction","rail","candidate","trace","result","authority"],
  "properties":{
    "task_id":{"type":"string","minLength":1},
    "instruction":{"type":"string","minLength":1},
    "rail":{"enum":["foundry-cua","orgo","openphone-local-eval"]},
    "candidate":{"type":"object","required":["name","revision"],"properties":{"name":{"type":"string"},"revision":{"type":"string"}},"additionalProperties":false},
    "trace":{"type":"array","minItems":1,"items":{"type":"object","required":["step","action","evidence_ref"],"properties":{"step":{"type":"integer","minimum":1},"action":{"type":"string"},"evidence_ref":{"type":"string","minLength":1}},"additionalProperties":true}},
    "result":{"type":"object","required":["complete","partial_accuracy","repeated_action_ratio"],"properties":{"complete":{"type":"boolean"},"partial_accuracy":{"type":"number","minimum":0,"maximum":1},"repeated_action_ratio":{"type":"number","minimum":0,"maximum":1}},"additionalProperties":true},
    "authority":{"type":"object","required":["external_side_effects","approved"],"properties":{"external_side_effects":{"type":"boolean"},"approved":{"type":"boolean"}},"additionalProperties":true}
  },
  "additionalProperties":false
}

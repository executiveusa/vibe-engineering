{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"starnet://schemas/rollout-receipt",
  "type":"object",
  "required":["candidate_sha","harness_recipe_sha","task_set_sha","model","traces","judge","accepted"],
  "properties":{
    "candidate_sha":{"type":"string","minLength":7},
    "harness_recipe_sha":{"type":"string","minLength":7},
    "task_set_sha":{"type":"string","minLength":7},
    "model":{"type":"string","minLength":1},
    "traces":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "judge":{"type":"object","required":["independent","evidence_refs"],"properties":{"independent":{"type":"boolean","const":true},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}}},"additionalProperties":true},
    "accepted":{"type":"boolean"}
  },
  "additionalProperties":true
}
